rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && (role() == 'admin' || role() == 'superadmin');
    }
    function isSuperAdmin() { return signedIn() && role() == 'superadmin'; }
    function memberOf(tid) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/teams/$(tid)).data.memberUids;
    }

    // ---- Lapangan / turnamen / pertandingan terjadwal ----
    match /courts/{courtId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tournaments/{tId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Pertandingan: publik bisa melihat; admin penuh; pembuat tanding
    // mandiri (hostUid) mengelola pertandingan & skornya sendiri.
    match /matches/{mId} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() &&
        request.resource.data.scope == 'private' &&
        request.resource.data.hostUid == request.auth.uid);
      // Admin penuh; host penuh; wasit yang terdaftar di refUids boleh
      // menulis skor; siapa pun (terautentikasi) boleh MENAMBAH dirinya
      // ke refUids — kunci keberhasilan ada pada kode wasit yang dirahasiakan.
      allow update: if isAdmin() ||
        (signedIn() && resource.data.hostUid == request.auth.uid) ||
        (signedIn() && resource.data.refUids is list &&
          request.auth.uid in resource.data.refUids) ||
        (signedIn() && resource.data.refUids is list &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['refUids']) &&
          request.resource.data.refUids.hasAll(resource.data.refUids)) ||
        // wasit mencabut dirinya sendiri (hanya mengurangi uid sendiri)
        (signedIn() && resource.data.refUids is list &&
          resource.data.refUids.removeAll([request.auth.uid])
            == request.resource.data.refUids);
      allow delete: if isAdmin();
    }

    // ---- Pengaturan aplikasi: hanya superadmin ----
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---- Tim ----
    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids.hasAll([request.auth.uid]);
      // Pemilik bebas; anggota lain hanya boleh MENAMBAH dirinya (join by code)
      allow update: if isAdmin() || resource.data.ownerUid == request.auth.uid ||
        (signedIn() && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['memberUids', 'members']) &&
         request.resource.data.memberUids.hasAll(resource.data.memberUids));
      allow delete: if isAdmin() || resource.data.ownerUid == request.auth.uid;
    }

    // ---- Chat tim: hanya anggota tim terkait ----
    match /messages/{msgId} {
      allow read: if isAdmin() || memberOf(resource.data.teamId);
      allow create: if memberOf(request.resource.data.teamId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }

    // ---- Pemesanan ----
    match /bookings/{bId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.endHour > request.resource.data.startHour
        && request.resource.data.startHour >= 0
        && request.resource.data.endHour <= 24
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // ---- Pengguna: peran hanya diubah admin ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pemain';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasNo(['role'])
            && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    // Tolak koleksi tak dikenal
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
